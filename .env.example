# Copy to .env.local for local dev (never commit .env.local).

# Public base URL of the media bucket, no trailing slash.
#   Production (Vercel env var): the Cloudflare R2 public URL, e.g. https://pub-xxxxxxxx.r2.dev or https://media.example.com
#   Local dev: the static server started by `npm run serve:media`
VITE_MEDIA_BASE=http://localhost:8787

# Optional basemap preset: esri-dark (default, no key) | stadia-dark | carto-dark | a {z}/{x}/{y} tile URL template.
# stadia-dark needs the site's domain registered in a free Stadia Maps account; carto-dark now watermarks keyless use.
# VITE_BASEMAP=esri-dark
